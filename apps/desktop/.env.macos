# Release settings for the macOS and Linux packaging targets.
# Unsigned builds need only the shared identity and policy settings below; the
# signing and notarization settings shown in .env.macos.example are required
# for signed releases prepared on a maintainer machine.
# A distinct application id keeps this build's OS-level identity (bundle
# identifier and installer registration) separate from the official build, so
# installing one never overwrites or uninstalls the other.
DSH_DESKTOP_APP_ID=com.stefano.dsh-datasecure
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://update.example.com
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedPageOrigins":["https://update.example.com"],"allowedAuthOrigins":["https://login.example.com"]}'
